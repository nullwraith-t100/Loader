--[[
    Uma Hub — Loader v1
    Clean router by PlaceId. Keysystem lives inside the scripts themselves.
    Edit SUPPORTED_GAMES to build your own hub.
]]

local CONFIG = {
    Name          = "Uma Hub",
    Version       = "1.0",
    NotifyTimeout = 4,
    UniversalUrl  = "", -- raw URL for the universal script when PlaceId isn't in the table
}

local LOGO = [[
 _   _  __  __     _       _   _  _   _  ____  
| | | ||  \/  |   / \     | | | || | | || __ ) 
| | | || \  / |  / _ \    | |_| || | | ||  _ \ 
| |_| || |\/| | / ___ \   |  _  || |_| || |_) |
 \___/ |_|  |_|/_/   \_\  |_| |_| \___/ |____/ 
                Uma Hub
]]

-- ============================================================
-- GAME TABLE
-- scriptUrl = raw URL, OR script = inline string. Use one of the two.
-- ============================================================
local SUPPORTED_GAMES = {
    [142823291] = {
        name      = "Murderer Mystery 2",
        scriptUrl = "https://raw.githubusercontent.com/nullwraith-t100/Loader/refs/heads/main/Scripts/Mm2.lua",
    },
}

-- ============================================================
local StarterGui = game:GetService("StarterGui")

local function log(...)
    print(("[%s] "):format(CONFIG.Name), ...)
end

local function notify(text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title    = CONFIG.Name,
            Text     = text,
            Duration = duration or CONFIG.NotifyTimeout,
        })
    end)
end

local function httpGet(url)
    if typeof(game.HttpGet) ~= "function" then
        error("HttpGet unavailable in this executor", 2)
    end
    local ok, body = pcall(game.HttpGet, game, url)
    if not ok then
        error("HttpGet failed: " .. tostring(body), 2)
    end
    return body
end

local function runScript(code, label)
    if not code or code == "" then
        log("Empty script:", label)
        return false
    end
    local fn, err = loadstring(code)
    if not fn then
        log("loadstring failed:", err)
        notify("Failed to load: " .. tostring(label), 5)
        return false
    end
    if setfenv then pcall(setfenv, fn, getgenv()) end
    local ok, runErr = pcall(fn)
    if not ok then
        log("Runtime error:", runErr)
        notify("Error: " .. tostring(runErr), 5)
        return false
    end
    return true
end

-- ============================================================
local function main()
    print(LOGO)
    log(("PlaceId: %d | JobId: %s"):format(game.PlaceId, game.JobId))

    local entry = SUPPORTED_GAMES[game.PlaceId]

    if entry then
        local code = entry.script
        if not code and entry.scriptUrl and entry.scriptUrl ~= "" then
            notify("Loading: " .. entry.name, 4)
            local ok, body = pcall(httpGet, entry.scriptUrl)
            if not ok then
                log("HttpGet failed:", entry.name, body)
                notify("Failed to download script.", 5)
                return
            end
            code = body
        end
        if code then
            log("Running:", entry.name)
            runScript(code, entry.name)
        else
            notify("No script set for " .. entry.name, 5)
        end
        return
    end

    if CONFIG.UniversalUrl ~= "" then
        notify("Game not listed. Running universal.", 4)
        local ok, body = pcall(httpGet, CONFIG.UniversalUrl)
        if ok then runScript(body, "universal") end
        return
    end

    notify("Unsupported game: " .. game.PlaceId, 5)
end

main()
